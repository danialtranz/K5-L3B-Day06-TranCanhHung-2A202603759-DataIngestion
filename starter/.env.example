# Local lab paths (no Docker). Copy to .env and adjust if needed.
# Leave PDF_PATH blank to auto-pick the first PDF under ../assets/
PDF_PATH=
DOCUMENT_ID=wiley_ddbms_ch5
SQLITE_PATH=data/lab.db
CHROMA_PATH=data/chroma
FIGURES_DIR=data/figures
RESULTS_DIR=results
QUESTIONS_PATH=data/questions.json

# Embedding (local SentenceTransformers; no API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chat generation — set ONE of the keys (do not repeat empty OPENAI_API_KEY= later)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Optional: kept for starter compatibility if you switch back to pgvector
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
GEMINI_API_KEY=
